# Clerk — auth provider (public/publishable key, safe for client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sanity — headless CMS
# SECRET: write-capable token. Do NOT prefix with EXPO_PUBLIC_ — it must never
# reach the client bundle. Only consumed server-side (API routes, sync script).
SANITY_API_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exercise DB sync script (scripts/sync.ts) — build-time only
EXPO_PUBLIC_EXERCISE_DB_API_URL=https://exercisedb-api-url.example.com
EXERCISE_DB_PAGE_SIZE=100
