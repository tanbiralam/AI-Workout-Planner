{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://n"
        }
      ],
      "expo-web-browser"
    ],
    "name": "fit-app",
    "slug": "fit-app",
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "origin": "https://n"
      },
      "eas": {
        "projectId": "2e8d2bc4-f641-47d8-a794-4c68981e542d"
      }
    },
    "android": {
      "package": "com.tanvirrrr.fitapp"
    },
    "ios": {
      "bundleIdentifier": "com.tanvirrrr.fitapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
